    "@eslint/js": "^10.0.1",
    "babel-jest": "^30.4.1",
    "css-loader": "^7.1.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "style-loader": "^4.0.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
